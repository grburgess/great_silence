{# scene.js.j2 - Scene initialization #}

let scene, camera, renderer, composer, controls;
let starGeometry, starMaterial, starPoints;
let civGeometry, civMaterial;
let civSprites = [];
let probeGeometry, probeMaterial;
let probeLines = [];
let hazardGeometry, hazardMaterial;
let hazardMeshes = [];

let clock;

// Hermite keyframe interpolation state
let hermiteEnabled = false;
let keyframes = [];
let currentKeyframeIndex = 0;
let keyframeBuffers = {
    pos0: null,
    vel0: null,
    pos1: null,
    vel1: null,
    time0: 0,
    time1: 0,
};

function onWindowResize() {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
    
    if (composer) {
        composer.setSize(window.innerWidth, window.innerHeight);
    }
}

function initScene() {
    clock = new THREE.Clock();
    
    const container = document.getElementById('canvas-container');

    scene = new THREE.Scene();
    scene.background = new THREE.Color(window.config.background_color || '#000000');

    camera = new THREE.PerspectiveCamera(
        window.config.camera_fov || 75,
        window.innerWidth / window.innerHeight,
        window.config.camera_near || 0.1,
        window.config.camera_far || 1000
    );

    camera.position.set(
        window.config.camera_position[0],
        window.config.camera_position[1],
        window.config.camera_position[2]
    );

    renderer = new THREE.WebGLRenderer({ antialias: true, preserveDrawingBuffer: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    container.appendChild(renderer.domElement);

    controls = new THREE.OrbitControls(camera, renderer.domElement);
    controls.enableDamping = window.config.enable_damping !== false;
    controls.dampingFactor = window.config.damping_factor || 0.05;
    controls.enableZoom = window.config.enable_zoom !== false;
    controls.autoRotate = window.config.auto_rotate || false;
    controls.autoRotateSpeed = window.config.auto_rotate_speed || 2.0;

    window.addEventListener('resize', onWindowResize);

    if (window.initLOD) {
        window.initLOD();
    }

    createStarField();
    createCivilizationSprites();
    createProbeTrails();
    createHazardMarkers();
}

// Stellar motion state
let stellarMotionEnabled = false;
let stellarReferenceTime = 0.0;  // Myr

function createStarField() {
    if (!window.galaxyData || !window.galaxyData.positions) return;

    const positions = window.galaxyData.positions;
    const colors = window.galaxyData.colors || [];
    const sizes = window.galaxyData.sizes || [];
    const count = positions.length;
    
    // Check for Hermite keyframe data (new system)
    hermiteEnabled = window.keyframeData && window.keyframeData.keyframes && window.keyframeData.keyframes.length >= 2;
    
    // Legacy check for old-style motion data
    const initialPositions = window.galaxyData.initial_positions || null;
    const velocities = window.galaxyData.velocities || null;
    stellarMotionEnabled = (initialPositions && velocities && initialPositions.length === count) || hermiteEnabled;
    stellarReferenceTime = window.galaxyData.reference_time || 0.0;

    starGeometry = new THREE.BufferGeometry();
    const positionArray = new Float32Array(count * 3);
    const colorArray = new Float32Array(count * 3);
    const sizeArray = new Float32Array(count);

    const baseSize = window.config.star_point_size || 0.05;

    for (let i = 0; i < count; i++) {
        positionArray[i * 3] = positions[i][0];
        positionArray[i * 3 + 1] = positions[i][1];
        positionArray[i * 3 + 2] = positions[i][2];

        if (colors.length > 0) {
            colorArray[i * 3] = colors[i][0];
            colorArray[i * 3 + 1] = colors[i][1];
            colorArray[i * 3 + 2] = colors[i][2];
        } else {
            colorArray[i * 3] = 1.0;
            colorArray[i * 3 + 1] = 0.95;
            colorArray[i * 3 + 2] = 0.9;
        }

        sizeArray[i] = sizes.length > 0 ? sizes[i] : baseSize;
    }

    starGeometry.setAttribute('position', new THREE.BufferAttribute(positionArray, 3));
    starGeometry.setAttribute('color', new THREE.BufferAttribute(colorArray, 3));
    starGeometry.setAttribute('size', new THREE.BufferAttribute(sizeArray, 1));
    
    // Initialize Hermite keyframe buffers if available
    if (hermiteEnabled) {
        initHermiteBuffers(count);
    }

    // Vertex shader with Hermite interpolation support
    const starVertexShader = hermiteEnabled ? `
        // Hermite interpolation vertex shader
        uniform float u_time0;       // Start keyframe time (Myr)
        uniform float u_time1;       // End keyframe time (Myr)
        uniform float u_currentTime; // Current animation time (Myr)
        uniform float u_velocityScale; // km/s to kpc/Myr conversion
        
        attribute float size;
        attribute vec3 color;
        attribute vec3 a_pos0;  // Position at keyframe 0
        attribute vec3 a_vel0;  // Velocity at keyframe 0 (km/s)
        attribute vec3 a_pos1;  // Position at keyframe 1
        attribute vec3 a_vel1;  // Velocity at keyframe 1 (km/s)
        
        varying vec3 vColor;
        varying float vDistance;
        
        vec3 hermiteInterpolate() {
            float h = u_time1 - u_time0;
            if (h < 0.001) return a_pos0; // Avoid division by zero
            
            float s = clamp((u_currentTime - u_time0) / h, 0.0, 1.0);
            float s2 = s * s;
            float s3 = s2 * s;
            
            // Hermite basis functions
            float h00 = 2.0*s3 - 3.0*s2 + 1.0;  // pos0 weight
            float h10 = s3 - 2.0*s2 + s;         // vel0 weight (tangent)
            float h01 = -2.0*s3 + 3.0*s2;        // pos1 weight
            float h11 = s3 - s2;                 // vel1 weight (tangent)
            
            // Scale velocities from km/s to kpc over the interval
            // 1 km/s = 0.001022 kpc/Myr, multiply by interval h
            vec3 v0_scaled = a_vel0 * u_velocityScale * h;
            vec3 v1_scaled = a_vel1 * u_velocityScale * h;
            
            return h00 * a_pos0 + h10 * v0_scaled + h01 * a_pos1 + h11 * v1_scaled;
        }
        
        void main() {
            vColor = color;
            
            // Compute interpolated position
            vec3 interpolatedPos = hermiteInterpolate();
            
            vec4 mvPosition = modelViewMatrix * vec4(interpolatedPos, 1.0);
            vDistance = -mvPosition.z;
            
            float scaledSize = size * (400.0 / max(vDistance, 0.1));
            gl_PointSize = max(scaledSize, 1.5);
            
            gl_Position = projectionMatrix * mvPosition;
        }
    ` : `
        // Standard vertex shader (no motion)
        attribute float size;
        attribute vec3 color;
        varying vec3 vColor;
        varying float vDistance;
        void main() {
            vColor = color;
            vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);
            vDistance = -mvPosition.z;
            
            // Size scales with distance, larger when closer
            float scaledSize = size * (400.0 / max(vDistance, 0.1));
            // Minimum size when far away to prevent disappearing
            gl_PointSize = max(scaledSize, 1.5);
            
            gl_Position = projectionMatrix * mvPosition;
        }
    `;
    
    const starOpacity = window.config.star_opacity || 0.85;
    
    const starFragmentShader = `
        uniform float opacity;
        uniform float farDistance;
        varying vec3 vColor;
        varying float vDistance;
        
        void main() {
            vec2 coord = gl_PointCoord - vec2(0.5);
            float dist = length(coord);
            
            // Distance-based blur: stars get softer/blurrier when zoomed out
            float blurFactor = clamp(vDistance / farDistance, 0.0, 1.0);
            
            // Core radius shrinks, glow expands with distance
            float coreRadius = mix(0.15, 0.05, blurFactor);
            float glowRadius = mix(0.35, 0.5, blurFactor);
            
            // Sharp core
            float core = 1.0 - smoothstep(0.0, coreRadius, dist);
            
            // Soft glow halo
            float glow = 1.0 - smoothstep(coreRadius, glowRadius, dist);
            glow = glow * glow; // Quadratic falloff for softer look
            
            // Outer blur (very soft)
            float outerGlow = 1.0 - smoothstep(glowRadius, 0.5, dist);
            outerGlow = outerGlow * 0.3 * blurFactor;
            
            // Combine: bright core + glow + outer blur
            float intensity = core + glow * 0.6 + outerGlow;
            intensity = clamp(intensity, 0.0, 1.0);
            
            if (intensity < 0.01) discard;
            
            // Color with slight boost for bright stars
            vec3 finalColor = vColor * (0.8 + intensity * 0.4);
            
            // Alpha based on intensity and overall opacity
            float alpha = intensity * opacity;
            
            gl_FragColor = vec4(finalColor, alpha);
        }
    `;

    // Create uniforms for star shader
    const uniforms = {
        opacity: { value: starOpacity },
        farDistance: { value: 50.0 }
    };
    
    // Add Hermite uniforms if enabled
    if (hermiteEnabled) {
        uniforms.u_time0 = { value: 0.0 };
        uniforms.u_time1 = { value: 1.0 };
        uniforms.u_currentTime = { value: 0.0 };
        uniforms.u_velocityScale = { value: window.config.velocity_conversion_factor || 0.001022 };
    }

    starMaterial = new THREE.ShaderMaterial({
        uniforms: uniforms,
        vertexShader: starVertexShader,
        fragmentShader: starFragmentShader,
        transparent: true,
        blending: THREE.AdditiveBlending,
        depthWrite: false
    });

    starPoints = new THREE.Points(starGeometry, starMaterial);
    scene.add(starPoints);
}

// Initialize Hermite interpolation buffers from keyframe data
function initHermiteBuffers(starCount) {
    if (!window.keyframeData || !window.keyframeData.keyframes) return;
    
    keyframes = window.keyframeData.keyframes;
    
    if (keyframes.length < 2) {
        hermiteEnabled = false;
        return;
    }
    
    // Create buffer arrays for first keyframe pair
    const kf0 = keyframes[0];
    const kf1 = keyframes[1];
    
    const pos0Array = new Float32Array(starCount * 3);
    const vel0Array = new Float32Array(starCount * 3);
    const pos1Array = new Float32Array(starCount * 3);
    const vel1Array = new Float32Array(starCount * 3);
    
    for (let i = 0; i < starCount; i++) {
        if (i < kf0.positions.length) {
            pos0Array[i * 3] = kf0.positions[i][0];
            pos0Array[i * 3 + 1] = kf0.positions[i][1];
            pos0Array[i * 3 + 2] = kf0.positions[i][2];
            
            vel0Array[i * 3] = kf0.velocities[i][0];
            vel0Array[i * 3 + 1] = kf0.velocities[i][1];
            vel0Array[i * 3 + 2] = kf0.velocities[i][2];
        }
        
        if (i < kf1.positions.length) {
            pos1Array[i * 3] = kf1.positions[i][0];
            pos1Array[i * 3 + 1] = kf1.positions[i][1];
            pos1Array[i * 3 + 2] = kf1.positions[i][2];
            
            vel1Array[i * 3] = kf1.velocities[i][0];
            vel1Array[i * 3 + 1] = kf1.velocities[i][1];
            vel1Array[i * 3 + 2] = kf1.velocities[i][2];
        }
    }
    
    // Add attributes to geometry
    starGeometry.setAttribute('a_pos0', new THREE.BufferAttribute(pos0Array, 3));
    starGeometry.setAttribute('a_vel0', new THREE.BufferAttribute(vel0Array, 3));
    starGeometry.setAttribute('a_pos1', new THREE.BufferAttribute(pos1Array, 3));
    starGeometry.setAttribute('a_vel1', new THREE.BufferAttribute(vel1Array, 3));
    
    // Store buffer state
    keyframeBuffers.pos0 = pos0Array;
    keyframeBuffers.vel0 = vel0Array;
    keyframeBuffers.pos1 = pos1Array;
    keyframeBuffers.vel1 = vel1Array;
    keyframeBuffers.time0 = kf0.time_myr;
    keyframeBuffers.time1 = kf1.time_myr;
    
    currentKeyframeIndex = 0;
    
    console.log(`[Hermite] Initialized with ${keyframes.length} keyframes, ${starCount} stars`);
    console.log(`[Hermite] First interval: ${kf0.time_myr} - ${kf1.time_myr} Myr`);
}

// Update Hermite keyframe buffers when time crosses a keyframe boundary
function updateHermiteKeyframes(timeMyr) {
    if (!hermiteEnabled || !starMaterial || !keyframes || keyframes.length < 2) return;
    
    // Find the correct keyframe interval
    let newIndex = 0;
    for (let i = 0; i < keyframes.length - 1; i++) {
        if (timeMyr >= keyframes[i].time_myr && timeMyr <= keyframes[i + 1].time_myr) {
            newIndex = i;
            break;
        }
        if (timeMyr > keyframes[i + 1].time_myr) {
            newIndex = i;
        }
    }
    
    // Clamp to valid range
    newIndex = Math.min(newIndex, keyframes.length - 2);
    
    // Check if we need to swap keyframe buffers
    if (newIndex !== currentKeyframeIndex) {
        swapKeyframeBuffers(newIndex);
    }
    
    // Always update current time uniform
    starMaterial.uniforms.u_currentTime.value = timeMyr;
}

// Swap to a new keyframe pair
function swapKeyframeBuffers(newIndex) {
    if (newIndex < 0 || newIndex >= keyframes.length - 1) return;
    
    const kf0 = keyframes[newIndex];
    const kf1 = keyframes[newIndex + 1];
    const starCount = starGeometry.getAttribute('a_pos0').count;
    
    console.log(`[Hermite] Swapping to keyframe pair ${newIndex}: ${kf0.time_myr} - ${kf1.time_myr} Myr`);
    
    // Update buffer arrays
    const pos0Attr = starGeometry.getAttribute('a_pos0');
    const vel0Attr = starGeometry.getAttribute('a_vel0');
    const pos1Attr = starGeometry.getAttribute('a_pos1');
    const vel1Attr = starGeometry.getAttribute('a_vel1');
    
    for (let i = 0; i < starCount; i++) {
        if (i < kf0.positions.length) {
            pos0Attr.setXYZ(i, kf0.positions[i][0], kf0.positions[i][1], kf0.positions[i][2]);
            vel0Attr.setXYZ(i, kf0.velocities[i][0], kf0.velocities[i][1], kf0.velocities[i][2]);
        }
        
        if (i < kf1.positions.length) {
            pos1Attr.setXYZ(i, kf1.positions[i][0], kf1.positions[i][1], kf1.positions[i][2]);
            vel1Attr.setXYZ(i, kf1.velocities[i][0], kf1.velocities[i][1], kf1.velocities[i][2]);
        }
    }
    
    pos0Attr.needsUpdate = true;
    vel0Attr.needsUpdate = true;
    pos1Attr.needsUpdate = true;
    vel1Attr.needsUpdate = true;
    
    // Update uniforms
    starMaterial.uniforms.u_time0.value = kf0.time_myr;
    starMaterial.uniforms.u_time1.value = kf1.time_myr;
    
    keyframeBuffers.time0 = kf0.time_myr;
    keyframeBuffers.time1 = kf1.time_myr;
    currentKeyframeIndex = newIndex;
}

// Update stellar positions based on current simulation time
function updateStellarTime(timeMyr) {
    // Use Hermite interpolation if available (smooth, memory-efficient)
    if (hermiteEnabled) {
        updateHermiteKeyframes(timeMyr);
        return;
    }
    // Otherwise, positions are updated directly via updateStellarPositions()
}

function createCivilizationSprites() {
    if (window.animationData && window.animationData.frames && window.animationData.frames.length > 0) {
        updateCivilizations(window.animationData.frames[0].civilizations);
    } else if (window.civData) {
        updateCivilizations(window.civData);
    }
}

function createProbeTrails() {
    if (window.animationData && window.animationData.frames && window.animationData.frames.length > 0) {
        updateProbes(window.animationData.frames[0].probes);
    } else if (window.probeData) {
        updateProbes(window.probeData);
    }
}

function createHazardMarkers() {
    if (window.animationData && window.animationData.frames && window.animationData.frames.length > 0) {
        updateHazards(window.animationData.frames[0].hazards);
    } else if (window.hazardData) {
        updateHazards(window.hazardData);
    }
}

function renderStatic() {
    renderer.render(scene, camera);
}

// Update star positions from snapshot data (for stellar motion visualization)
function updateStellarPositions(positions) {
    console.log('[StellarMotion] updateStellarPositions called with', positions ? positions.length : 0, 'positions');
    
    if (!starGeometry) {
        console.error('[StellarMotion] ERROR: No starGeometry!');
        return;
    }
    if (!positions || positions.length === 0) {
        console.error('[StellarMotion] ERROR: No positions data!');
        return;
    }
    
    const positionAttribute = starGeometry.getAttribute('position');
    if (!positionAttribute) {
        console.error('[StellarMotion] ERROR: No position attribute!');
        return;
    }
    
    const count = Math.min(positions.length, positionAttribute.count);
    
    // Debug: show position change for first star
    const oldPos = [positionAttribute.getX(0), positionAttribute.getY(0), positionAttribute.getZ(0)];
    const newPos = positions[0];
    const delta = Math.sqrt(
        Math.pow(newPos[0] - oldPos[0], 2) + 
        Math.pow(newPos[1] - oldPos[1], 2) + 
        Math.pow(newPos[2] - oldPos[2], 2)
    );
    console.log(`[StellarMotion] Updating ${count} stars. Star 0 moved ${delta.toFixed(4)} kpc: [${oldPos.map(x => x.toFixed(2))}] -> [${newPos.map(x => x.toFixed(2))}]`);
    
    for (let i = 0; i < count; i++) {
        positionAttribute.setXYZ(i, positions[i][0], positions[i][1], positions[i][2]);
    }
    
    positionAttribute.needsUpdate = true;
    
    // Force geometry update
    starGeometry.computeBoundingSphere();
    
    console.log('[StellarMotion] Position update complete');
}

function animate() {
    requestAnimationFrame(animate);

    const delta = clock.getDelta();

    TWEEN.update();
    controls.update();

    if (window.updateCameraSystem) {
        window.updateCameraSystem(delta);
    }

    if (window.updateLOD) {
        window.updateLOD();
    }

    if (window.isPlaying && window.updateAnimation) {
        window.updateAnimation(delta);
    }

    if (composer && window.usePostProcessing) {
        composer.render();
    } else {
        renderer.render(scene, camera);
    }
}

function updateStarsVisible(visible) {
    if (starPoints) {
        starPoints.visible = visible;
    }
}

function updateCivizationsVisible(visible) {
    civSprites.forEach(sprite => {
        sprite.visible = visible;
    });
}

function updateProbesVisible(visible) {
    probeLines.forEach(line => {
        line.visible = visible;
    });
}

function updateHazardsVisible(visible) {
    hazardMeshes.forEach(mesh => {
        mesh.visible = visible;
    });
}

window.initScene = initScene;
window.onWindowResize = onWindowResize;
window.renderStatic = renderStatic;
window.animate = animate;
window.updateStarsVisible = updateStarsVisible;
window.updateCivizationsVisible = updateCivizationsVisible;
window.updateProbesVisible = updateProbesVisible;
window.updateHazardsVisible = updateHazardsVisible;
window.updateStellarTime = updateStellarTime;
window.updateStellarPositions = updateStellarPositions;
window.isStellarMotionEnabled = function() { return stellarMotionEnabled; };
window.isHermiteEnabled = function() { return hermiteEnabled; };
window.updateHermiteKeyframes = updateHermiteKeyframes;
window.getKeyframes = function() { return keyframes; };

// Export scene and camera for other modules
window.getScene = function() { return scene; };
window.getCamera = function() { return camera; };
