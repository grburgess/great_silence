{# particles.js.j2 - Enhanced particle system with Hermite interpolation #}

function initParticles() {
    updateParticles();
}

function updateParticles() {
    if (!starPoints || !starGeometry) return;

    if (starGeometry.attributes.position) {
        starGeometry.attributes.position.needsUpdate = true;
    }
    if (starGeometry.attributes.color) {
        starGeometry.attributes.color.needsUpdate = true;
    }
    if (starGeometry.attributes.size) {
        starGeometry.attributes.size.needsUpdate = true;
    }
}

// Hermite interpolation helper for computing civ/colony positions
// Uses the same math as the GPU shader for consistency
function hermiteInterpolateCPU(p0, v0, p1, v1, time0, time1, currentTime, velocityScale) {
    const h = time1 - time0;
    if (h < 0.001) return [...p0];
    
    let s = (currentTime - time0) / h;
    s = Math.max(0, Math.min(1, s));
    const s2 = s * s;
    const s3 = s2 * s;
    
    // Hermite basis functions
    const h00 = 2*s3 - 3*s2 + 1;
    const h10 = s3 - 2*s2 + s;
    const h01 = -2*s3 + 3*s2;
    const h11 = s3 - s2;
    
    // Scale velocities
    const scale = velocityScale * h;
    
    return [
        h00 * p0[0] + h10 * v0[0] * scale + h01 * p1[0] + h11 * v1[0] * scale,
        h00 * p0[1] + h10 * v0[1] * scale + h01 * p1[1] + h11 * v1[1] * scale,
        h00 * p0[2] + h10 * v0[2] * scale + h01 * p1[2] + h11 * v1[2] * scale,
    ];
}

// Get star position at a given time using Hermite interpolation
function getStarPositionAtTime(starIdx, timeMyr) {
    if (!window.isHermiteEnabled || !window.isHermiteEnabled()) {
        // Fall back to static position from galaxy data
        if (window.galaxyData && window.galaxyData.positions && starIdx < window.galaxyData.positions.length) {
            return window.galaxyData.positions[starIdx];
        }
        return [0, 0, 0];
    }
    
    const keyframes = window.getKeyframes ? window.getKeyframes() : [];
    if (keyframes.length < 2) {
        if (window.galaxyData && window.galaxyData.positions && starIdx < window.galaxyData.positions.length) {
            return window.galaxyData.positions[starIdx];
        }
        return [0, 0, 0];
    }
    
    // Find keyframe interval
    let kfIndex = 0;
    for (let i = 0; i < keyframes.length - 1; i++) {
        if (timeMyr >= keyframes[i].time_myr && timeMyr <= keyframes[i + 1].time_myr) {
            kfIndex = i;
            break;
        }
        if (timeMyr > keyframes[i + 1].time_myr) {
            kfIndex = i;
        }
    }
    kfIndex = Math.min(kfIndex, keyframes.length - 2);
    
    const kf0 = keyframes[kfIndex];
    const kf1 = keyframes[kfIndex + 1];
    
    if (starIdx >= kf0.positions.length) {
        return [0, 0, 0];
    }
    
    const velocityScale = window.config.velocity_conversion_factor || 0.001022;
    
    return hermiteInterpolateCPU(
        kf0.positions[starIdx],
        kf0.velocities[starIdx],
        kf1.positions[starIdx],
        kf1.velocities[starIdx],
        kf0.time_myr,
        kf1.time_myr,
        timeMyr,
        velocityScale
    );
}

function createCivilizationSprite(civData, currentTimeMyr) {
    const canvas = document.createElement('canvas');
    canvas.width = 64;
    canvas.height = 64;
    const ctx = canvas.getContext('2d');

    const kardashev = civData.kardashev;
    const baseColor = getKardashevColor(kardashev);

    const gradient = ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
    gradient.addColorStop(0, baseColor);
    gradient.addColorStop(0.4, baseColor);
    gradient.addColorStop(1, 'transparent');

    ctx.fillStyle = gradient;
    ctx.beginPath();
    ctx.arc(32, 32, 32, 0, Math.PI * 2);
    ctx.fill();

    const texture = new THREE.CanvasTexture(canvas);
    const material = new THREE.SpriteMaterial({
        map: texture,
        transparent: true,
        opacity: civData.is_active ? (window.config.civ_active_opacity || 0.9) : (window.config.civ_extinct_opacity || 0.5),
        blending: THREE.AdditiveBlending
    });

    const sprite = new THREE.Sprite(material);
    
    // Compute position: use Hermite interpolation if available and star_idx is provided
    let position = civData.position;
    if (civData.star_idx !== undefined && currentTimeMyr !== undefined) {
        position = getStarPositionAtTime(civData.star_idx, currentTimeMyr);
    }
    
    sprite.position.set(position[0], position[1], position[2]);
    sprite.scale.set(
        civData.is_active ? (window.config.civ_active_size || 0.15) : (window.config.civ_extinct_size || 0.1),
        civData.is_active ? (window.config.civ_active_size || 0.15) : (window.config.civ_extinct_size || 0.1),
        1
    );
    sprite.userData = civData;

    return sprite;
}

function getKardashevColor(kardashev) {
    const minK = window.config.kardashev_min || 0.7;
    const maxK = window.config.kardashev_max || 3.0;

    const normalized = Math.max(0, Math.min(1, (kardashev - minK) / (maxK - minK)));

    const colorscale = window.config.kardashev_colorscale || 'viridis';

    switch (colorscale) {
        case 'viridis':
            if (normalized < 0.2) return '#440154';
            if (normalized < 0.4) return '#3b528b';
            if (normalized < 0.6) return '#21918c';
            if (normalized < 0.8) return '#5ec962';
            return '#fde725';
        case 'plasma':
            if (normalized < 0.2) return '#0d0887';
            if (normalized < 0.4) return '#7e03a8';
            if (normalized < 0.6) return '#cc4778';
            if (normalized < 0.8) return '#f89540';
            return '#f0f921';
        case 'inferno':
            if (normalized < 0.2) return '#000004';
            if (normalized < 0.4) return '#5a1132';
            if (normalized < 0.6) return '#b5367a';
            if (normalized < 0.8) return '#ef8636';
            return '#fcffa4';
        default:
            if (normalized < 0.5) {
                const r = Math.floor(255 * (1 - normalized * 2));
                const g = Math.floor(255 * normalized * 2);
                return `rgb(${r}, ${g}, 255)`;
            } else {
                const r = Math.floor(255 * (normalized - 0.5) * 2);
                const g = Math.floor(255 * (1 - (normalized - 0.5) * 2));
                return `rgb(255, ${g}, ${255 - r})`;
            }
    }
}

let showCivSprites = true;
let showProbeSprites = true;
let showHazardSprites = true;
let currentAnimationTimeMyr = 0;

// Civilization visualization state (similar to disaster state)
window.civState = {
    showExtinct: true,       // Show extinct civs (history mode)
    showOnlyExpanding: false // Only show civs that have colonized
};

function updateCivilizations(civilizations, timeMyr) {
    civSprites.forEach(sprite => scene.remove(sprite));
    civSprites = [];
    
    // Update current time for interpolation
    if (timeMyr !== undefined) {
        currentAnimationTimeMyr = timeMyr;
    }

    const maxAge = Math.max(...civilizations.map(c => c.age), 0.01);
    const downsampleCutoff = maxAge * (downsamplePercent / 100);

    civilizations.forEach(civ => {
        if (downsamplePercent > 0 && civ.age > downsampleCutoff) {
            return;
        }
        
        // Filter by extinct status if not showing extinct
        if (!window.civState.showExtinct && civ.is_extinct) {
            return;
        }
        
        // Filter to only expanding civs if enabled
        if (window.civState.showOnlyExpanding && !civ.has_colonies) {
            return;
        }

        const sprite = createCivilizationSprite(civ, currentAnimationTimeMyr);
        sprite.visible = showCivSprites;
        civSprites.push(sprite);
        scene.add(sprite);
    });
}

function setCivShowExtinct(show) {
    window.civState.showExtinct = show;
    // Force refresh of current frame
    if (window.animationData && window.animationData.frames && window.animationData.frames[window.currentFrame]) {
        updateCivilizations(window.animationData.frames[window.currentFrame].civilizations, currentAnimationTimeMyr);
    }
}

function setCivShowOnlyExpanding(show) {
    window.civState.showOnlyExpanding = show;
    // Force refresh of current frame
    if (window.animationData && window.animationData.frames && window.animationData.frames[window.currentFrame]) {
        updateCivilizations(window.animationData.frames[window.currentFrame].civilizations, currentAnimationTimeMyr);
    }
}

function setCivVisibility(visible) {
    showCivSprites = visible;
    civSprites.forEach(sprite => {
        sprite.visible = visible;
    });
}

function createProbeTrail(probeData, timeMyr) {
    const positions = [];
    const colors = [];
    
    let currentPos = probeData.position;
    let launchPos = [0, 0, 0];
    
    if (probeData.launch_star_idx !== undefined && probeData.target_star_idx !== undefined && timeMyr !== undefined) {
        launchPos = getStarPositionAtTime(probeData.launch_star_idx, timeMyr);
        const targetPos = getStarPositionAtTime(probeData.target_star_idx, timeMyr);
        const progress = probeData.progress || 0;
        currentPos = [
            launchPos[0] + (targetPos[0] - launchPos[0]) * progress,
            launchPos[1] + (targetPos[1] - launchPos[1]) * progress,
            launchPos[2] + (targetPos[2] - launchPos[2]) * progress
        ];
    }

    const trailLength = 10;
    for (let i = 0; i < trailLength; i++) {
        const t = i / (trailLength - 1);
        const x = launchPos[0] + (currentPos[0] - launchPos[0]) * (1 - t * 0.3);
        const y = launchPos[1] + (currentPos[1] - launchPos[1]) * (1 - t * 0.3);
        const z = launchPos[2] + (currentPos[2] - launchPos[2]) * (1 - t * 0.3);

        positions.push(x, y, z);
        const alpha = 1.0 - t * 0.7;
        colors.push(0, alpha, alpha);
    }

    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
    geometry.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));

    const material = new THREE.LineBasicMaterial({
        vertexColors: true,
        transparent: true,
        opacity: window.config.trajectory_opacity || 0.6,
        linewidth: window.config.trajectory_width || 2.0,
        blending: THREE.AdditiveBlending
    });

    const line = new THREE.Line(geometry, material);
    line.userData = probeData;

    return line;
}

function updateProbes(probes, timeMyr) {
    probeLines.forEach(line => scene.remove(line));
    probeLines = [];

    probes.forEach(probe => {
        const line = createProbeTrail(probe, timeMyr);
        line.visible = showProbeSprites;
        probeLines.push(line);
        scene.add(line);
    });
}

function setProbeVisibility(visible) {
    showProbeSprites = visible;
    probeLines.forEach(line => {
        line.visible = visible;
    });
}

function createHazardMarker(hazardData) {
    const geometry = new THREE.SphereGeometry(
        (window.config.hazard_marker_size || 0.3),
        16,
        16
    );

    let color;
    switch (hazardData.type.toLowerCase()) {
        case 'supernova':
        case 'sn':
            color = window.config.hazard_supernova_color || '#ff4444';
            break;
        case 'grb':
        case 'gamma':
            color = window.config.hazard_grb_color || '#ffaa00';
            break;
        case 'nsm':
        case 'merger':
        case 'ns_merger':
        case 'kilonova':
            color = window.config.hazard_nsm_color || '#aa44ff';
            break;
        default:
            color = '#ff0000';
    }

    const material = new THREE.MeshBasicMaterial({
        color: color,
        transparent: true,
        opacity: window.config.hazard_opacity || 0.7,
        blending: THREE.AdditiveBlending
    });

    const mesh = new THREE.Mesh(geometry, material);
    mesh.position.set(hazardData.position[0], hazardData.position[1], hazardData.position[2]);
    mesh.userData = hazardData;

    return mesh;
}

function updateHazards(hazards) {
    hazardMeshes.forEach(mesh => scene.remove(mesh));
    hazardMeshes = [];

    hazards.forEach(hazard => {
        // Check if this hazard type should be shown based on disaster filters
        if (window.disasterState) {
            const type = hazard.type.toLowerCase();
            if ((type === 'supernova' || type === 'sn') && !window.disasterState.showSupernovae) return;
            if ((type === 'grb' || type === 'gamma') && !window.disasterState.showGRBs) return;
            if ((type === 'nsm' || type === 'merger' || type === 'ns_merger' || type === 'kilonova') && !window.disasterState.showNSMergers) return;
        }
        
        const mesh = createHazardMarker(hazard);
        mesh.visible = showHazardSprites;
        hazardMeshes.push(mesh);
        scene.add(mesh);
    });
}

function setHazardVisibility(visible) {
    showHazardSprites = visible;
    hazardMeshes.forEach(mesh => {
        mesh.visible = visible;
    });
}

let trajectoryLines = [];
let showTrajectoryLines = true;

window.trajectoryState = {
    showGhostAnchors: true,
    showDriftLines: true,
    showFuturePath: true,
    showCompletedTrajectories: false,
    trailLengthMyr: 0.05,
    ghostDriftThreshold: 0.5,
    completedOpacity: 0.15,
    maxVisibleTrajectories: 500,
};

function getTrajectoryPositions(traj) {
    const launchPos = traj.launch_position || traj.start || [0, 0, 0];
    const interceptPos = traj.intercept_position || traj.end || [0, 0, 0];
    return { launchPos, interceptPos };
}

function createWorldlineTrajectory(trajectory, progress, currentTimeMyr) {
    const group = new THREE.Group();
    
    const civId = trajectory.civ_id || 0;
    const hue = (civId * 0.618033988749895) % 1.0;
    const color = new THREE.Color().setHSL(hue, 0.9, 0.6);
    const ghostColor = 0x888888;
    
    const { launchPos, interceptPos } = getTrajectoryPositions(trajectory);
    
    if (!launchPos || !interceptPos || 
        (launchPos[0] === 0 && launchPos[1] === 0 && launchPos[2] === 0) ||
        (interceptPos[0] === 0 && interceptPos[1] === 0 && interceptPos[2] === 0)) {
        return group;
    }
    
    const arrivalTimeMyr = trajectory.time_myr || 0;
    const launchTimeMyr = trajectory.launch_time_myr || (arrivalTimeMyr - 100);
    const travelTime = arrivalTimeMyr - launchTimeMyr;
    const isInFlight = progress !== undefined && progress < 1.0 && progress > 0;
    const isCompleted = progress >= 1.0;
    
    if (isCompleted && !window.trajectoryState.showCompletedTrajectories) {
        return group;
    }
    
    const baseOpacity = isCompleted ? window.trajectoryState.completedOpacity : 0.7;
    
    const currentProbePos = isInFlight ? [
        launchPos[0] + (interceptPos[0] - launchPos[0]) * progress,
        launchPos[1] + (interceptPos[1] - launchPos[1]) * progress,
        launchPos[2] + (interceptPos[2] - launchPos[2]) * progress
    ] : (isCompleted ? interceptPos : launchPos);
    
    const trailLineGeom = new THREE.BufferGeometry();
    trailLineGeom.setAttribute('position', new THREE.Float32BufferAttribute([
        launchPos[0], launchPos[1], launchPos[2],
        currentProbePos[0], currentProbePos[1], currentProbePos[2]
    ], 3));
    
    const trailLineMat = new THREE.LineBasicMaterial({
        color: color,
        transparent: true,
        opacity: baseOpacity,
        linewidth: 2,
        blending: THREE.AdditiveBlending
    });
    
    const trailLine = new THREE.Line(trailLineGeom, trailLineMat);
    group.add(trailLine);
    
    if (isInFlight && window.trajectoryState.showFuturePath) {
        const futureLineGeom = new THREE.BufferGeometry();
        futureLineGeom.setAttribute('position', new THREE.Float32BufferAttribute([
            currentProbePos[0], currentProbePos[1], currentProbePos[2],
            interceptPos[0], interceptPos[1], interceptPos[2]
        ], 3));
        
        const futureMat = new THREE.LineDashedMaterial({
            color: color,
            transparent: true,
            opacity: 0.25,
            dashSize: 0.15,
            gapSize: 0.1,
            blending: THREE.AdditiveBlending
        });
        
        const futureLine = new THREE.Line(futureLineGeom, futureMat);
        futureLine.computeLineDistances();
        group.add(futureLine);
    }
    
    if (isInFlight) {
        const dotGeom = new THREE.SphereGeometry(0.12, 12, 12);
        const dotMat = new THREE.MeshBasicMaterial({
            color: color,
            transparent: true,
            opacity: 1.0,
            blending: THREE.AdditiveBlending
        });
        const probeDot = new THREE.Mesh(dotGeom, dotMat);
        probeDot.position.set(currentProbePos[0], currentProbePos[1], currentProbePos[2]);
        group.add(probeDot);
    }
    
    if (isInFlight && window.trajectoryState.showGhostAnchors) {
        const launchStarIdx = trajectory.launch_star_idx;
        const targetStarIdx = trajectory.target_star_idx;
        
        let currentLaunchStarPos = null;
        let currentTargetStarPos = null;
        
        if (launchStarIdx !== undefined && window.getStarPositionAtTime) {
            currentLaunchStarPos = window.getStarPositionAtTime(launchStarIdx, currentTimeMyr);
        }
        if (targetStarIdx !== undefined && window.getStarPositionAtTime) {
            currentTargetStarPos = window.getStarPositionAtTime(targetStarIdx, currentTimeMyr);
        }
        
        const launchDrift = currentLaunchStarPos ? Math.sqrt(
            Math.pow(currentLaunchStarPos[0] - launchPos[0], 2) +
            Math.pow(currentLaunchStarPos[1] - launchPos[1], 2) +
            Math.pow(currentLaunchStarPos[2] - launchPos[2], 2)
        ) : 0;
        
        const targetDrift = currentTargetStarPos ? Math.sqrt(
            Math.pow(currentTargetStarPos[0] - interceptPos[0], 2) +
            Math.pow(currentTargetStarPos[1] - interceptPos[1], 2) +
            Math.pow(currentTargetStarPos[2] - interceptPos[2], 2)
        ) : 0;
        
        const threshold = window.trajectoryState.ghostDriftThreshold;
        
        if (launchDrift > threshold) {
            const ghostGeom = new THREE.OctahedronGeometry(0.08);
            const ghostMat = new THREE.MeshBasicMaterial({
                color: ghostColor,
                transparent: true,
                opacity: 0.5,
                blending: THREE.AdditiveBlending
            });
            const launchGhost = new THREE.Mesh(ghostGeom, ghostMat);
            launchGhost.position.set(launchPos[0], launchPos[1], launchPos[2]);
            group.add(launchGhost);
            
            if (window.trajectoryState.showDriftLines && currentLaunchStarPos) {
                const driftLineGeom = new THREE.BufferGeometry();
                driftLineGeom.setAttribute('position', new THREE.Float32BufferAttribute([
                    launchPos[0], launchPos[1], launchPos[2],
                    currentLaunchStarPos[0], currentLaunchStarPos[1], currentLaunchStarPos[2]
                ], 3));
                
                const driftMat = new THREE.LineDashedMaterial({
                    color: ghostColor,
                    transparent: true,
                    opacity: 0.25,
                    dashSize: 0.08,
                    gapSize: 0.08,
                });
                
                const driftLine = new THREE.Line(driftLineGeom, driftMat);
                driftLine.computeLineDistances();
                group.add(driftLine);
            }
        }
        
        if (targetDrift > threshold) {
            const ghostGeom = new THREE.OctahedronGeometry(0.08);
            const ghostMat = new THREE.MeshBasicMaterial({
                color: ghostColor,
                transparent: true,
                opacity: 0.5,
                blending: THREE.AdditiveBlending
            });
            const targetGhost = new THREE.Mesh(ghostGeom, ghostMat);
            targetGhost.position.set(interceptPos[0], interceptPos[1], interceptPos[2]);
            group.add(targetGhost);
            
            if (window.trajectoryState.showDriftLines && currentTargetStarPos) {
                const driftLineGeom = new THREE.BufferGeometry();
                driftLineGeom.setAttribute('position', new THREE.Float32BufferAttribute([
                    interceptPos[0], interceptPos[1], interceptPos[2],
                    currentTargetStarPos[0], currentTargetStarPos[1], currentTargetStarPos[2]
                ], 3));
                
                const driftMat = new THREE.LineDashedMaterial({
                    color: ghostColor,
                    transparent: true,
                    opacity: 0.25,
                    dashSize: 0.08,
                    gapSize: 0.08,
                });
                
                const driftLine = new THREE.Line(driftLineGeom, driftMat);
                driftLine.computeLineDistances();
                group.add(driftLine);
            }
        }
    }
    
    group.userData = trajectory;
    return group;
}

function updateTrajectories(trajectories, currentTimeGyr) {
    trajectoryLines.forEach(obj => scene.remove(obj));
    trajectoryLines = [];

    if (!showTrajectoryLines) return;
    if (!trajectories || !Array.isArray(trajectories)) return;

    const currentTimeMyr = (currentTimeGyr || 0) * 1000;
    
    const cameraDistance = camera ? camera.position.length() : 50;
    const isZoomedOut = cameraDistance > 80;
    
    const inFlightTrajs = [];
    const completedTrajs = [];
    
    trajectories.forEach(traj => {
        const { launchPos, interceptPos } = getTrajectoryPositions(traj);
        if (!launchPos || !interceptPos) return;
        if (launchPos[0] === 0 && launchPos[1] === 0 && launchPos[2] === 0) return;
        if (interceptPos[0] === 0 && interceptPos[1] === 0 && interceptPos[2] === 0) return;
        
        const arrivalTimeMyr = traj.time_myr || 0;
        const launchTimeMyr = traj.launch_time_myr || (arrivalTimeMyr - 100);
        const travelTime = arrivalTimeMyr - launchTimeMyr;
        
        if (currentTimeMyr >= launchTimeMyr) {
            let progress;
            if (currentTimeMyr < arrivalTimeMyr && travelTime > 0) {
                progress = Math.min(1.0, (currentTimeMyr - launchTimeMyr) / travelTime);
                inFlightTrajs.push({ traj, progress });
            } else {
                progress = 1.0;
                completedTrajs.push({ traj, progress });
            }
        }
    });
    
    const maxVisible = window.trajectoryState.maxVisibleTrajectories || 500;
    
    const prevShowGhosts = window.trajectoryState.showGhostAnchors;
    if (isZoomedOut) {
        window.trajectoryState.showGhostAnchors = false;
    }
    
    inFlightTrajs.forEach(({ traj, progress }) => {
        const obj = createWorldlineTrajectory(traj, progress, currentTimeMyr);
        if (obj && obj.children.length > 0) {
            trajectoryLines.push(obj);
            scene.add(obj);
        }
    });
    
    if (window.trajectoryState.showCompletedTrajectories) {
        const remainingSlots = Math.max(0, maxVisible - inFlightTrajs.length);
        const completedToShow = completedTrajs.slice(0, remainingSlots);
        
        completedToShow.forEach(({ traj, progress }) => {
            const obj = createWorldlineTrajectory(traj, progress, currentTimeMyr);
            if (obj && obj.children.length > 0) {
                trajectoryLines.push(obj);
                scene.add(obj);
            }
        });
    }
    
    window.trajectoryState.showGhostAnchors = prevShowGhosts;
}

function setTrajectoryVisibility(visible) {
    showTrajectoryLines = visible;
    trajectoryLines.forEach(obj => {
        obj.visible = visible;
    });
}

function setTrajectoryGhostAnchors(show) {
    window.trajectoryState.showGhostAnchors = show;
}

function setTrajectoryDriftLines(show) {
    window.trajectoryState.showDriftLines = show;
}

function setTrajectoryFuturePath(show) {
    window.trajectoryState.showFuturePath = show;
}

function updateCivilizationDisplay(percent) {
    downsamplePercent = percent;
    if (window.animationData && window.animationData.frames[currentFrame]) {
        updateCivilizations(window.animationData.frames[currentFrame].civilizations);
    }
}

window.initParticles = initParticles;
window.updateParticles = updateParticles;
window.createCivilizationSprite = createCivilizationSprite;
window.updateCivilizations = updateCivilizations;
window.setCivVisibility = setCivVisibility;
window.setCivShowExtinct = setCivShowExtinct;
window.setCivShowOnlyExpanding = setCivShowOnlyExpanding;
window.createProbeTrail = createProbeTrail;
window.updateProbes = updateProbes;
window.setProbeVisibility = setProbeVisibility;
window.createHazardMarker = createHazardMarker;
window.updateHazards = updateHazards;
window.setHazardVisibility = setHazardVisibility;
window.updateCivilizationDisplay = updateCivilizationDisplay;
window.createWorldlineTrajectory = createWorldlineTrajectory;
window.updateTrajectories = updateTrajectories;
