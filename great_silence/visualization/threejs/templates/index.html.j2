<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Galactic Civilization Visualization</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #000000;
            overflow: hidden;
            color: white;
        }

        #container {
            width: 100vw;
            height: 100vh;
            position: relative;
        }

        #canvas-container {
            width: 100%;
            height: 100%;
        }

        #loading-screen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #000000;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        #loading-spinner {
            width: 50px;
            height: 50px;
            border: 3px solid #333;
            border-top: 3px solid #00ffff;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-bottom: 20px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        #loading-text {
            font-size: 18px;
            color: #00ffff;
        }

        #ui-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            display: none;
        }

        #ui-overlay > * {
            pointer-events: auto;
        }

        #top-bar {
            position: absolute;
            top: 10px;
            left: 10px;
            right: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px;
            background: rgba(0, 0, 0, 0.7);
            border-radius: 5px;
        }

        #title {
            font-size: 16px;
            font-weight: bold;
            color: #00ffff;
        }

        #stats {
            font-size: 12px;
            color: #aaa;
        }

        #controls-panel {
            position: absolute;
            bottom: 10px;
            left: 10px;
            right: 10px;
            background: rgba(0, 0, 0, 0.8);
            border-radius: 5px;
            padding: 15px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        #timeline-container {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        #playback-controls {
            display: flex;
            gap: 5px;
        }

        .btn {
            background: #333;
            color: white;
            border: 1px solid #555;
            padding: 8px 12px;
            border-radius: 3px;
            cursor: pointer;
            font-size: 14px;
            transition: background 0.2s;
        }

        .btn:hover {
            background: #555;
        }

        .btn.active {
            background: #00ffff;
            color: black;
        }

        #timeline-slider {
            flex: 1;
            -webkit-appearance: none;
            height: 8px;
            background: #333;
            border-radius: 4px;
            outline: none;
        }

        #timeline-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 16px;
            height: 16px;
            background: #00ffff;
            border-radius: 50%;
            cursor: pointer;
        }

        #time-display {
            font-size: 14px;
            color: #00ffff;
            min-width: 100px;
            text-align: right;
        }

        #speed-control {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        #speed-slider {
            width: 150px;
            -webkit-appearance: none;
            height: 8px;
            background: #333;
            border-radius: 4px;
            outline: none;
        }

        #speed-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 16px;
            height: 16px;
            background: #00ffff;
            border-radius: 50%;
            cursor: pointer;
        }

        #layer-controls {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        #camera-presets {
            display: flex;
            gap: 5px;
        }

        #info-panel {
            position: absolute;
            top: 60px;
            right: 10px;
            width: 250px;
            background: rgba(0, 0, 0, 0.9);
            border: 1px solid #333;
            border-radius: 5px;
            padding: 15px;
            display: none;
        }

        #info-panel h3 {
            color: #00ffff;
            margin-bottom: 10px;
            font-size: 14px;
        }

        #info-panel p {
            font-size: 12px;
            margin: 5px 0;
            color: #ccc;
        }

        #info-panel .label {
            color: #888;
        }

        #mini-map {
            position: absolute;
            top: 10px;
            right: 10px;
            width: 150px;
            height: 150px;
            background: rgba(0, 0, 0, 0.8);
            border: 1px solid #333;
            border-radius: 5px;
        }

        #downsample-container {
            display: none;
            align-items: center;
            gap: 10px;
        }

        #downsample-slider {
            width: 150px;
            -webkit-appearance: none;
            height: 8px;
            background: #333;
            border-radius: 4px;
            outline: none;
        }

        #downsample-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 16px;
            height: 16px;
            background: #ff6600;
            border-radius: 50%;
            cursor: pointer;
        }

        .tooltip {
            position: absolute;
            background: rgba(0, 0, 0, 0.9);
            border: 1px solid #00ffff;
            border-radius: 5px;
            padding: 10px;
            pointer-events: none;
            display: none;
            z-index: 100;
            max-width: 200px;
        }

        .tooltip h4 {
            color: #00ffff;
            margin-bottom: 5px;
            font-size: 12px;
        }

        .tooltip p {
            font-size: 10px;
            margin: 3px 0;
            color: #ccc;
        }

        /* Floating Chart Panels */
        .chart-panel {
            position: absolute;
            background: rgba(10, 10, 20, 0.92);
            border: 1px solid #2a4a6a;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            min-width: 320px;
            min-height: 200px;
            display: none;
            z-index: 100;
            backdrop-filter: blur(4px);
        }

        .chart-panel.visible {
            display: block;
        }

        .chart-panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 12px;
            background: linear-gradient(180deg, rgba(40, 60, 90, 0.8) 0%, rgba(20, 35, 55, 0.8) 100%);
            border-bottom: 1px solid #2a4a6a;
            border-radius: 7px 7px 0 0;
            cursor: move;
            user-select: none;
        }

        .chart-panel-title {
            font-size: 13px;
            font-weight: 600;
            color: #8ac4ff;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .chart-panel-close {
            background: none;
            border: none;
            color: #667;
            font-size: 18px;
            cursor: pointer;
            padding: 0 4px;
            line-height: 1;
            transition: color 0.2s;
        }

        .chart-panel-close:hover {
            color: #ff6666;
        }

        .chart-panel-content {
            padding: 12px;
            overflow: hidden;
        }

        .chart-panel-content canvas {
            width: 100%;
            height: 100%;
            display: block;
        }

        .chart-panel.focused {
            z-index: 101;
            border-color: #4a8aff;
        }

        /* Chart toggle buttons */
        #chart-controls {
            display: flex;
            gap: 5px;
            padding-top: 8px;
            border-top: 1px solid #333;
            margin-top: 8px;
        }

        #chart-controls .btn {
            background: #1a2a3a;
            border-color: #2a4a6a;
            font-size: 11px;
            padding: 6px 10px;
        }

        #chart-controls .btn:hover {
            background: #2a3a4a;
        }

        #chart-controls .btn.active {
            background: #2a5a8a;
            border-color: #4a8aff;
            color: #fff;
        }

        /* Chart-specific styles */
        .hr-legend {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 8px;
            font-size: 10px;
        }

        .hr-legend-item {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .hr-legend-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }

        .chart-stats {
            display: flex;
            justify-content: space-around;
            padding: 8px 0;
            border-top: 1px solid #2a4a6a;
            margin-top: 8px;
            font-size: 11px;
        }

        .chart-stat {
            text-align: center;
        }

        .chart-stat-value {
            color: #8ac4ff;
            font-weight: bold;
            font-size: 14px;
        }

        .chart-stat-label {
            color: #667;
        }

        /* Camera and Loop Mode Controls */
        .mode-controls {
            display: flex;
            gap: 10px;
            align-items: center;
            padding: 5px 0;
        }

        .mode-select {
            background: #222;
            color: #fff;
            border: 1px solid #444;
            border-radius: 3px;
            padding: 5px 10px;
            font-size: 12px;
            cursor: pointer;
        }

        .mode-select:hover {
            border-color: #00ffff;
        }

        .mode-select:focus {
            outline: none;
            border-color: #00ffff;
        }

        #tour-controls, #follow-controls {
            display: none;
            gap: 8px;
            align-items: center;
        }

        #tour-progress-bar {
            width: 100px;
            height: 4px;
            background: #333;
            border-radius: 2px;
            overflow: hidden;
        }

        #tour-progress {
            width: 0%;
            height: 100%;
            background: #00ffff;
            transition: width 0.1s linear;
        }

        #fly-mode-hint {
            display: none;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(0, 0, 0, 0.85);
            border: 1px solid #00ffff;
            border-radius: 8px;
            padding: 20px;
            z-index: 200;
            text-align: center;
            pointer-events: none;
            opacity: 1;
            transition: opacity 0.5s ease-out;
        }

        #fly-mode-hint.fading {
            opacity: 0;
        }

        #fly-mode-hint h3 {
            color: #00ffff;
            margin-bottom: 10px;
        }

        #fly-mode-hint .key {
            display: inline-block;
            background: #333;
            border: 1px solid #555;
            border-radius: 3px;
            padding: 2px 8px;
            margin: 2px;
            font-family: monospace;
        }

        #keyboard-help-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            z-index: 500;
            justify-content: center;
            align-items: center;
        }

        #keyboard-help-content {
            background: #111;
            border: 1px solid #333;
            border-radius: 10px;
            padding: 30px;
            max-width: 600px;
            max-height: 80vh;
            overflow-y: auto;
        }

        #keyboard-help-content h2 {
            color: #00ffff;
            margin-bottom: 20px;
            text-align: center;
        }

        .help-section {
            margin-bottom: 20px;
        }

        .help-section h4 {
            color: #888;
            margin-bottom: 10px;
            border-bottom: 1px solid #333;
            padding-bottom: 5px;
        }

        .help-row {
            display: flex;
            justify-content: space-between;
            padding: 5px 0;
        }

        .help-key {
            background: #222;
            border: 1px solid #444;
            border-radius: 3px;
            padding: 3px 10px;
            font-family: monospace;
            font-size: 13px;
        }

        .help-desc {
            color: #aaa;
        }

        .loop-mode-btn, .camera-mode-btn {
            font-size: 11px;
            padding: 5px 8px;
        }

        /* Recording indicator styles */
        #recording-indicator {
            display: none;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            background: rgba(255, 0, 0, 0.2);
            border: 1px solid #ff0000;
            border-radius: 5px;
            margin-left: 10px;
        }

        #recording-indicator.active {
            display: flex;
        }

        .recording-dot {
            width: 12px;
            height: 12px;
            background: #ff0000;
            border-radius: 50%;
            animation: pulse-recording 1s infinite;
        }

        @keyframes pulse-recording {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.3; }
        }

        #recording-status {
            font-size: 12px;
            color: #ff6666;
            font-weight: bold;
        }

        .btn.recording {
            background: #660000;
            border-color: #ff0000;
            color: #ff6666;
        }

        .btn.recording:hover {
            background: #880000;
        }
    </style>

    <script type="importmap">
    {
        "imports": {
            "three": "https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js",
            "three/webgpu": "https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js",
            "three/tsl": "https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.tsl.js",
            "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/"
        }
    }
    </script>
    <script>
        // Feature-detect WebGPU. When present we use the modern WebGPURenderer
        // path (GPU-computed epicyclic star positions); otherwise we fall back
        // to the r128 WebGL renderer loaded below.
        window.__USE_WEBGPU = (typeof navigator !== 'undefined' && !!navigator.gpu);
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tweenjs/tween.js@18.6.4/dist/tween.umd.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/CopyShader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/LuminosityHighPassShader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/FilmShader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/EffectComposer.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/RenderPass.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/ShaderPass.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/UnrealBloomPass.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/FilmPass.js"></script>
    <script>
        window.addEventListener('error', function(e) {
            if (e.target.tagName === 'SCRIPT') {
                console.error('Script failed to load:', e.target.src);
                if (e.target.src.includes('three')) {
                    document.getElementById('loading-text').textContent = 'Loading Three.js libraries...';
                }
            }
        }, true);
    </script>
</head>
<body>
    <div id="container">
        <div id="canvas-container"></div>

        <div id="loading-screen">
            <div id="loading-spinner"></div>
            <div id="loading-text">Loading visualization...</div>
        </div>

        <div id="ui-overlay">
            <div id="top-bar">
                <div id="title">Galactic Civilization Visualization</div>
                <div id="stats">
                    <span id="time-stats">Time: 0.00 Gyr</span>
                    <span id="civ-stats">Active: 0 | Total: 0</span>
                </div>
                <div id="mini-map">
                    <canvas id="mini-map-canvas"></canvas>
                </div>
            </div>

            <div id="info-panel">
                <h3>Civilization Details</h3>
                <p><span class="label">ID:</span> <span id="info-civ-id">-</span></p>
                <p><span class="label">Kardashev:</span> <span id="info-kardashev">-</span></p>
                <p><span class="label">Age:</span> <span id="info-age">-</span></p>
                <p><span class="label">Status:</span> <span id="info-status">-</span></p>
                <p><span class="label">Position:</span> <span id="info-position">-</span></p>
            </div>

            <div class="tooltip" id="tooltip">
                <h4 id="tooltip-title">Civilization</h4>
                <p id="tooltip-content"></p>
            </div>

            <!-- Fly Mode Hint -->
            <div id="fly-mode-hint">
                <h3>Fly-Through Mode</h3>
                <p>
                    <span class="key">W</span><span class="key">A</span><span class="key">S</span><span class="key">D</span> Move
                </p>
                <p>
                    <span class="key">Q</span> Down <span class="key">E</span> Up
                </p>
                <p>
                    <span class="key">Shift</span> Boost
                </p>
                <p>
                    <span class="key">Esc</span> or <span class="key">F</span> Exit
                </p>
                <p style="font-size: 10px; color: #666; margin-top: 10px;">Move mouse to look around</p>
                <p style="font-size: 10px; color: #444; margin-top: 5px;">Press <span class="key" style="font-size: 10px; padding: 1px 5px;">H</span> to show this again</p>
            </div>

            <!-- Keyboard Help Overlay -->
            <div id="keyboard-help-overlay" onclick="this.style.display='none'">
                <div id="keyboard-help-content" onclick="event.stopPropagation()">
                    <h2>Keyboard Shortcuts</h2>
                    
                    <div class="help-section">
                        <h4>Playback</h4>
                        <div class="help-row"><span class="help-key">Space</span><span class="help-desc">Play / Pause</span></div>
                        <div class="help-row"><span class="help-key">→</span><span class="help-desc">Step forward</span></div>
                        <div class="help-row"><span class="help-key">←</span><span class="help-desc">Step backward</span></div>
                    </div>
                    
                    <div class="help-section">
                        <h4>Camera (Orbit Mode)</h4>
                        <div class="help-row"><span class="help-key">W A S D</span><span class="help-desc">Pan camera</span></div>
                        <div class="help-row"><span class="help-key">Arrow Keys</span><span class="help-desc">Rotate camera</span></div>
                        <div class="help-row"><span class="help-key">+ / -</span><span class="help-desc">Zoom in / out</span></div>
                        <div class="help-row"><span class="help-key">F</span><span class="help-desc">Enter fly-through mode</span></div>
                    </div>
                    
                    <div class="help-section">
                        <h4>Fly-Through Mode</h4>
                        <div class="help-row"><span class="help-key">W A S D</span><span class="help-desc">Move forward/back/left/right</span></div>
                        <div class="help-row"><span class="help-key">Q / E</span><span class="help-desc">Move down / up</span></div>
                        <div class="help-row"><span class="help-key">Shift</span><span class="help-desc">Boost speed</span></div>
                        <div class="help-row"><span class="help-key">Esc / F</span><span class="help-desc">Exit fly-through</span></div>
                    </div>
                    
                    <div class="help-section">
                        <h4>General</h4>
                        <div class="help-row"><span class="help-key">?</span><span class="help-desc">Toggle this help</span></div>
                        <div class="help-row"><span class="help-key">Esc</span><span class="help-desc">Cancel tour / follow mode</span></div>
                    </div>
                    
                    <p style="text-align: center; color: #666; margin-top: 20px;">Click outside to close</p>
                </div>
            </div>

            <!-- Floating Chart Panels -->
            <div class="chart-panel" id="panel-hr" style="top: 70px; left: 10px; width: 380px; height: 320px;">
                <div class="chart-panel-header">
                    <span class="chart-panel-title">HR Diagram</span>
                    <button class="chart-panel-close" data-panel="panel-hr">&times;</button>
                </div>
                <div class="chart-panel-content">
                    <canvas id="chart-hr" width="356" height="240"></canvas>
                    <div class="hr-legend">
                        <div class="hr-legend-item"><span class="hr-legend-dot" style="background: #9bb0ff;"></span>O/B</div>
                        <div class="hr-legend-item"><span class="hr-legend-dot" style="background: #fff;"></span>A/F</div>
                        <div class="hr-legend-item"><span class="hr-legend-dot" style="background: #ffcc6f;"></span>G</div>
                        <div class="hr-legend-item"><span class="hr-legend-dot" style="background: #ff8a00;"></span>K</div>
                        <div class="hr-legend-item"><span class="hr-legend-dot" style="background: #ff3300;"></span>M</div>
                        <div class="hr-legend-item"><span class="hr-legend-dot" style="background: #00ff88; border: 1px solid #00ff88;"></span>Habitable</div>
                    </div>
                </div>
            </div>

            <div class="chart-panel" id="panel-kardashev" style="top: 70px; left: 400px; width: 340px; height: 280px;">
                <div class="chart-panel-header">
                    <span class="chart-panel-title">Kardashev Distribution</span>
                    <button class="chart-panel-close" data-panel="panel-kardashev">&times;</button>
                </div>
                <div class="chart-panel-content">
                    <canvas id="chart-kardashev" width="316" height="200"></canvas>
                    <div class="chart-stats" id="kardashev-stats">
                        <div class="chart-stat"><span class="chart-stat-value" id="k-min">-</span><br><span class="chart-stat-label">Min</span></div>
                        <div class="chart-stat"><span class="chart-stat-value" id="k-avg">-</span><br><span class="chart-stat-label">Avg</span></div>
                        <div class="chart-stat"><span class="chart-stat-value" id="k-max">-</span><br><span class="chart-stat-label">Max</span></div>
                    </div>
                </div>
            </div>

            <div class="chart-panel" id="panel-timeline" style="top: 360px; left: 10px; width: 400px; height: 260px;">
                <div class="chart-panel-header">
                    <span class="chart-panel-title">Birth / Death Timeline</span>
                    <button class="chart-panel-close" data-panel="panel-timeline">&times;</button>
                </div>
                <div class="chart-panel-content">
                    <canvas id="chart-timeline" width="376" height="180"></canvas>
                    <div class="chart-stats" id="timeline-stats">
                        <div class="chart-stat"><span class="chart-stat-value" id="total-births">0</span><br><span class="chart-stat-label">Births</span></div>
                        <div class="chart-stat"><span class="chart-stat-value" id="total-deaths">0</span><br><span class="chart-stat-label">Deaths</span></div>
                        <div class="chart-stat"><span class="chart-stat-value" id="survival-rate">-</span><br><span class="chart-stat-label">Survival</span></div>
                    </div>
                </div>
            </div>

            <div class="chart-panel" id="panel-colony" style="top: 360px; left: 420px; width: 340px; height: 260px;">
                <div class="chart-panel-header">
                    <span class="chart-panel-title">Colony Expansion</span>
                    <button class="chart-panel-close" data-panel="panel-colony">&times;</button>
                </div>
                <div class="chart-panel-content">
                    <canvas id="chart-colony" width="316" height="180"></canvas>
                    <div class="chart-stats" id="colony-stats">
                        <div class="chart-stat"><span class="chart-stat-value" id="total-colonies">0</span><br><span class="chart-stat-label">Colonies</span></div>
                        <div class="chart-stat"><span class="chart-stat-value" id="expanding-civs">0</span><br><span class="chart-stat-label">Expanding</span></div>
                    </div>
                </div>
            </div>

            <div class="chart-panel" id="panel-lifespan" style="top: 70px; left: 750px; width: 320px; height: 280px;">
                <div class="chart-panel-header">
                    <span class="chart-panel-title">Civilization Lifespans</span>
                    <button class="chart-panel-close" data-panel="panel-lifespan">&times;</button>
                </div>
                <div class="chart-panel-content">
                    <canvas id="chart-lifespan" width="296" height="180"></canvas>
                    <div class="chart-stats" id="lifespan-stats">
                        <div class="chart-stat"><span class="chart-stat-value" id="avg-lifespan">-</span><br><span class="chart-stat-label">Avg (Myr)</span></div>
                        <div class="chart-stat"><span class="chart-stat-value" id="max-lifespan">-</span><br><span class="chart-stat-label">Max (Myr)</span></div>
                        <div class="chart-stat"><span class="chart-stat-value" id="median-lifespan">-</span><br><span class="chart-stat-label">Median</span></div>
                    </div>
                </div>
            </div>

            <div id="controls-panel">
                <div id="timeline-container">
                    <div id="playback-controls">
                        <button class="btn" id="btn-jump-start" title="Jump to Start">⏮</button>
                        <button class="btn" id="btn-step-back" title="Step Back">← Step</button>
                        <button class="btn" id="btn-playpause">▶ Play</button>
                        <button class="btn" id="btn-step" title="Step Forward">Step →</button>
                        <button class="btn" id="btn-jump-end" title="Jump to End">⏭</button>
                        <button class="btn" id="btn-reset">↺ Reset</button>
                    </div>
                    <input type="range" id="timeline-slider" min="0" max="100" value="0">
                    <div id="time-display">0.00 Gyr</div>
                </div>

                <div id="speed-control">
                    <span style="font-size: 12px; color: #888;">Speed:</span>
                    <input type="range" id="speed-slider" min="0.1" max="10" step="0.1" value="1.0">
                    <span id="speed-display" style="font-size: 12px; color: #00ffff;">1.0x</span>
                    
                    <span style="font-size: 12px; color: #888; margin-left: 15px;">Loop:</span>
                    <select id="loop-mode-select" class="mode-select">
                        <option value="once">Once ⏹</option>
                        <option value="repeat" selected>Repeat 🔁</option>
                        <option value="pingpong">Ping-Pong 🔄</option>
                    </select>
                </div>

                <div id="layer-controls">
                    <button class="btn active" id="btn-stars">Stars</button>
                    <button class="btn active" id="btn-civs">Civilizations</button>
                    <button class="btn active" id="btn-probes">Probes</button>
                    <button class="btn active" id="btn-hazards">Hazards</button>
                    <button class="btn active" id="btn-trajectories">Trajectories</button>
                    <button class="btn" id="btn-postprocess">Effects</button>
                    <button class="btn" id="btn-export">Export Frame</button>
                    <button class="btn" id="btn-record">🎬 Record Video</button>
                    <div id="recording-indicator">
                        <div class="recording-dot"></div>
                        <span id="recording-status">Recording... Loop 1/3</span>
                    </div>
                </div>

                <!-- Disaster Visualization Panel -->
                <div id="disaster-panel" style="display: flex; gap: 15px; flex-wrap: wrap; align-items: center; padding-top: 5px; border-top: 1px solid #333;">
                    <div style="font-size: 11px; color: #ff6600; font-weight: bold;">DISASTERS</div>
                    
                    <div style="display: flex; align-items: center; gap: 5px;">
                        <input type="checkbox" id="disaster-history-toggle">
                        <label for="disaster-history-toggle" style="font-size: 11px; color: #888;" id="history-mode-label">Current Only</label>
                    </div>
                    
                    <div style="display: flex; align-items: center; gap: 5px;">
                        <input type="checkbox" id="disaster-scale-toggle">
                        <label for="disaster-scale-toggle" style="font-size: 11px; color: #888;" id="scale-mode-label">Physical Scale</label>
                    </div>
                    
                    <div style="display: flex; gap: 8px;">
                        <label style="font-size: 11px; display: flex; align-items: center; gap: 3px;">
                            <input type="checkbox" id="filter-supernova" checked>
                            <span style="color: #ff4400;">SN</span>
                        </label>
                        <label style="font-size: 11px; display: flex; align-items: center; gap: 3px;">
                            <input type="checkbox" id="filter-grb" checked>
                            <span style="color: #00ffff;">GRB</span>
                        </label>
                        <label style="font-size: 11px; display: flex; align-items: center; gap: 3px;">
                            <input type="checkbox" id="filter-nsm" checked>
                            <span style="color: #ff00ff;">NSM</span>
                        </label>
                    </div>
                    
                    <div style="display: flex; gap: 8px;">
                        <label style="font-size: 11px; display: flex; align-items: center; gap: 3px;">
                            <input type="checkbox" id="show-zones" checked>
                            <span style="color: #aaa;">Zones</span>
                        </label>
                        <label style="font-size: 11px; display: flex; align-items: center; gap: 3px;">
                            <input type="checkbox" id="show-beams" checked>
                            <span style="color: #aaa;">Beams</span>
                        </label>
                        <label style="font-size: 11px; display: flex; align-items: center; gap: 3px;">
                            <input type="checkbox" id="show-death-markers" checked>
                            <span style="color: #aaa;">Deaths</span>
                        </label>
                    </div>
                    
                    <div id="disaster-count" style="font-size: 11px; margin-left: auto;"></div>
                </div>
                
                <!-- Disaster Timeline -->
                <div id="disaster-timeline" style="width: 100%; height: 20px; margin-top: 5px;">
                    <canvas id="disaster-timeline-canvas" width="800" height="20" style="width: 100%; height: 100%; border-radius: 3px;"></canvas>
                </div>

                <div id="downsample-container">
                    <span style="font-size: 12px; color: #888;">Show:</span>
                    <input type="range" id="downsample-slider" min="0" max="90" value="0">
                    <span id="downsample-display" style="font-size: 12px; color: #ff6600;">All</span>
                </div>

                <div id="camera-presets">
                    <button class="btn" id="btn-cam-top">Top View</button>
                    <button class="btn" id="btn-cam-edge">Edge View</button>
                    <button class="btn" id="btn-cam-angle">Angled View</button>
                    <button class="btn" id="btn-cam-autorotate">Auto-Rotate</button>
                    
                    <span style="margin-left: 15px; font-size: 12px; color: #888;">Camera Mode:</span>
                    <select id="camera-mode-select" class="mode-select">
                        <option value="orbit">Orbit</option>
                        <option value="follow">Follow</option>
                        <option value="fly">Fly-through</option>
                        <option value="tour">Tour</option>
                    </select>
                    
                    <div id="follow-controls">
                        <span style="font-size: 11px; color: #888;">Target:</span>
                        <select id="follow-target-select" class="mode-select" style="min-width: 150px;">
                            <option value="">Select civilization...</option>
                        </select>
                    </div>
                    
                    <div id="tour-controls">
                        <select id="tour-select" class="mode-select">
                            <option value="">Select tour...</option>
                        </select>
                        <button class="btn" id="btn-tour-play" style="padding: 5px 10px;">▶</button>
                        <button class="btn" id="btn-tour-stop" style="padding: 5px 10px;">⏹</button>
                        <div id="tour-progress-bar">
                            <div id="tour-progress"></div>
                        </div>
                        <span id="tour-name" style="font-size: 11px; color: #888;"></span>
                    </div>
                </div>

                <!-- Chart Toggle Controls -->
                <div id="chart-controls">
                    <span style="font-size: 11px; color: #8ac4ff; font-weight: bold; margin-right: 5px;">CHARTS</span>
                    <button class="btn" id="btn-chart-hr" title="HR Diagram">HR</button>
                    <button class="btn" id="btn-chart-kardashev" title="Kardashev Distribution">K-Scale</button>
                    <button class="btn" id="btn-chart-timeline" title="Birth/Death Timeline">Timeline</button>
                    <button class="btn" id="btn-chart-colony" title="Colony Expansion">Colonies</button>
                    <button class="btn" id="btn-chart-lifespan" title="Civilization Lifespans">Lifespan</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        window.config = {{ config | tojson | safe }};
        window.showTrajectories = {{ show_trajectories | lower }};
        window.showSpheres = {{ show_spheres | lower }};
        window.showHazards = {{ show_hazards | lower }};
        window.animated = {{ animated | lower }};
    </script>

    <script src="scene.js?v={{ range(1000000) | random }}"></script>
    <script src="camera.js?v={{ range(1000000) | random }}"></script>
    <script src="particles.js?v={{ range(1000000) | random }}"></script>
    <script src="layers.js?v={{ range(1000000) | random }}"></script>
    <script src="lod.js?v={{ range(1000000) | random }}"></script>
    <script src="charts.js?v={{ range(1000000) | random }}"></script>
    <script src="ui.js?v={{ range(1000000) | random }}"></script>
    <script src="postprocess.js?v={{ range(1000000) | random }}"></script>
    <script src="recorder.js?v={{ range(1000000) | random }}"></script>

    <script>
        {% if data.galaxy %}
        window.galaxyData = {{ data.galaxy | tojson | safe }};
        {% endif %}

        {% if animated and animation_data %}
        window.animationData = {
            frames: {{ animation_data | safe }},
            time_range: {{ data.time_range | tojson | safe }}
        };
        {% endif %}

        {% if not animated %}
        window.civData = {{ data.civilizations | tojson | safe }};
        window.trajectoryData = {{ data.trajectories | tojson | safe }};
        window.probeData = {{ data.probes | tojson | safe }};
        window.hazardData = {{ data.hazards | tojson | safe }};
        window.cameraPresets = {{ data.camera_presets | tojson | safe }};
        {% endif %}

        {% if data.hr_data %}
        window.hrData = {{ data.hr_data | tojson | safe }};
        {% endif %}

        {% if data.civ_stats %}
        window.civStatsData = {{ data.civ_stats | tojson | safe }};
        {% endif %}

        function init() {
            if (typeof THREE === 'undefined') {
                document.getElementById('loading-text').textContent = 'Error: Three.js failed to load. Please check your internet connection and refresh.';
                console.error('THREE is not defined. Check browser console for CDN loading errors.');
                return;
            }

            initScene();
            initCamera();
            initParticles();
            
            // Initialize disaster visualization layers
            if (window.initializeDisasterLayers) {
                window.initializeDisasterLayers(window.config);
            }
            
            // Initialize chart panels
            if (window.initCharts) {
                window.initCharts();
            }
            
            initUI();
            initPostProcessing();

            if (window.animationData) {
                initAnimation();
            } else {
                renderStatic();
            }

            document.getElementById('loading-screen').style.display = 'none';
            document.getElementById('ui-overlay').style.display = 'block';

            animate();
        }

        window.onload = function () {
            if (!window.__USE_WEBGPU) {
                init();
            }
        };
    </script>

    <script type="module">
        // WebGPU path: shader-computed epicyclic star positions, cinematic look.
        // Falls back to the WebGL init() if WebGPU init throws (e.g. headless).
        if (window.__USE_WEBGPU) {
            try {
                const mod = await import('./webgpu/galaxy-webgpu.mjs?v={{ range(1000000) | random }}');
                await mod.initWebGPUGalaxy();
                // Charts + chart-toggle buttons are renderer-independent (Chart.js/DOM)
                // and normally wired inside the WebGL init(); the WebGPU path skips init(),
                // so wire them explicitly here.
                if (window.initCharts) window.initCharts();
                if (window.initChartToggleControls) window.initChartToggleControls();
            } catch (err) {
                console.error('WebGPU init failed, falling back to WebGL:', err);
                window.__USE_WEBGPU = false;
                if (typeof init === 'function') {
                    init();
                }
            }
        }
    </script>
</body>
</html>
