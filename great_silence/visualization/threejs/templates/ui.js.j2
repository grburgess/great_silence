{# ui.js.j2 - User interface system #}

let isPlaying = false;
let currentFrame = 0;
let playbackSpeed = 1.0;
let showStars = true;
let showCivs = true;
let showProbes = true;
let showHazards = true;
let showTrajectories = true;
let usePostProcessing = false;
let downsamplePercent = 0;

let loopMode = 'repeat';
let playbackDirection = 1;

function initUI() {
    initPlaybackControls();
    initLoopModeControls();
    initLayerControls();
    initChartToggleControls();
    initDisasterControls();
    initSpeedControl();
    initDownsampleControl();
    initExportButton();
    initRaycaster();
    initMiniMap();
    initDisasterTimeline();
    initCameraModeControls();

    if (window.initRecorder) {
        window.initRecorder();
    }

    const savedLoopMode = localStorage.getItem('loopMode');
    if (savedLoopMode) {
        setLoopMode(savedLoopMode);
    }
}

function initPlaybackControls() {
    const btnPlayPause = document.getElementById('btn-playpause');
    const btnStep = document.getElementById('btn-step');
    const btnReset = document.getElementById('btn-reset');
    const btnStepBack = document.getElementById('btn-step-back');
    const btnJumpStart = document.getElementById('btn-jump-start');
    const btnJumpEnd = document.getElementById('btn-jump-end');
    const timelineSlider = document.getElementById('timeline-slider');

    btnPlayPause.addEventListener('click', togglePlayPause);
    btnStep.addEventListener('click', stepForward);
    btnReset.addEventListener('click', resetPlayback);

    if (btnStepBack) btnStepBack.addEventListener('click', stepBackward);
    if (btnJumpStart) btnJumpStart.addEventListener('click', jumpToStart);
    if (btnJumpEnd) btnJumpEnd.addEventListener('click', jumpToEnd);

    timelineSlider.addEventListener('input', (e) => {
        currentFrame = parseInt(e.target.value);
        window.currentFrame = currentFrame;
        if (window.animationData) {
            updateFrame(currentFrame);
        }
    });
}

function initLoopModeControls() {
    const loopModeSelect = document.getElementById('loop-mode-select');
    if (loopModeSelect) {
        loopModeSelect.addEventListener('change', (e) => {
            setLoopMode(e.target.value);
        });
    }

    document.querySelectorAll('.loop-mode-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            setLoopMode(btn.dataset.mode);
        });
    });
}

function setLoopMode(mode) {
    loopMode = mode;
    playbackDirection = 1;

    localStorage.setItem('loopMode', mode);

    const loopModeSelect = document.getElementById('loop-mode-select');
    if (loopModeSelect) loopModeSelect.value = mode;

    document.querySelectorAll('.loop-mode-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.mode === mode);
    });

    const loopModeDisplay = document.getElementById('loop-mode-display');
    if (loopModeDisplay) {
        const modeNames = { once: '⏹ Once', repeat: '🔁 Repeat', pingpong: '🔄 Ping-Pong' };
        loopModeDisplay.textContent = modeNames[mode] || mode;
    }
}

function initCameraModeControls() {
    const cameraModeSelect = document.getElementById('camera-mode-select');
    if (cameraModeSelect) {
        cameraModeSelect.addEventListener('change', (e) => {
            if (window.setCameraMode) {
                window.setCameraMode(e.target.value);
            }
        });
    }

    document.querySelectorAll('.camera-mode-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            if (window.setCameraMode) {
                window.setCameraMode(btn.dataset.mode);
            }
        });
    });

    const followSelect = document.getElementById('follow-target-select');
    if (followSelect) {
        followSelect.addEventListener('change', (e) => {
            if (e.target.value && window.enableFollowMode) {
                window.enableFollowMode(parseInt(e.target.value));
            }
        });
    }
}

function stepBackward() {
    isPlaying = false;
    window.isPlaying = false;
    document.getElementById('btn-playpause').textContent = '▶ Play';

    if (window.animationData) {
        currentFrame = Math.max(currentFrame - 1, 0);
        window.currentFrame = currentFrame;
        document.getElementById('timeline-slider').value = currentFrame;
        updateFrame(currentFrame);
    }
}

function jumpToStart() {
    currentFrame = 0;
    window.currentFrame = 0;
    playbackDirection = 1;
    document.getElementById('timeline-slider').value = 0;
    if (window.animationData) {
        updateFrame(0);
    }
}

function jumpToEnd() {
    if (window.animationData) {
        currentFrame = window.animationData.frames.length - 1;
        window.currentFrame = currentFrame;
        playbackDirection = -1;
        document.getElementById('timeline-slider').value = currentFrame;
        updateFrame(currentFrame);
    }
}

function initLayerControls() {
    document.getElementById('btn-stars').addEventListener('click', (e) => {
        showStars = !showStars;
        e.target.classList.toggle('active', showStars);
        updateStarsVisible(showStars);
    });

    document.getElementById('btn-civs').addEventListener('click', (e) => {
        showCivs = !showCivs;
        e.target.classList.toggle('active', showCivs);
        if (window.setCivVisibility) {
            window.setCivVisibility(showCivs);
        }
    });

    document.getElementById('btn-probes').addEventListener('click', (e) => {
        showProbes = !showProbes;
        e.target.classList.toggle('active', showProbes);
        if (window.setProbeVisibility) {
            window.setProbeVisibility(showProbes);
        }
    });

    document.getElementById('btn-hazards').addEventListener('click', (e) => {
        showHazards = !showHazards;
        e.target.classList.toggle('active', showHazards);
        if (window.setHazardVisibility) {
            window.setHazardVisibility(showHazards);
        }
    });

    const trajBtn = document.getElementById('btn-trajectories');
    if (trajBtn) {
        trajBtn.addEventListener('click', (e) => {
            showTrajectories = !showTrajectories;
            e.target.classList.toggle('active', showTrajectories);
            if (window.setTrajectoryVisibility) {
                window.setTrajectoryVisibility(showTrajectories);
            }
        });
    }

    document.getElementById('btn-postprocess').addEventListener('click', (e) => {
        usePostProcessing = !usePostProcessing;
        e.target.classList.toggle('active', usePostProcessing);
        window.usePostProcessing = usePostProcessing;
    });
}

function initChartToggleControls() {
    const chartButtons = {
        'btn-chart-hr': 'panel-hr',
        'btn-chart-kardashev': 'panel-kardashev',
        'btn-chart-timeline': 'panel-timeline',
        'btn-chart-colony': 'panel-colony',
        'btn-chart-lifespan': 'panel-lifespan'
    };
    
    Object.entries(chartButtons).forEach(([btnId, panelId]) => {
        const btn = document.getElementById(btnId);
        if (btn) {
            btn.addEventListener('click', (e) => {
                e.target.classList.toggle('active');
                if (window.toggleChartPanel) {
                    window.toggleChartPanel(panelId);
                }
                
                if (e.target.classList.contains('active')) {
                    const frameIdx = window.currentFrame || 0;
                    if (panelId === 'panel-hr' && window.renderHRDiagram) {
                        window.renderHRDiagram(frameIdx);
                    } else if (panelId === 'panel-kardashev' && window.renderKardashevHistogram) {
                        window.renderKardashevHistogram(frameIdx);
                    } else if (panelId === 'panel-timeline' && window.renderBirthDeathTimeline) {
                        window.renderBirthDeathTimeline(frameIdx);
                    } else if (panelId === 'panel-colony' && window.renderColonyExpansion) {
                        window.renderColonyExpansion(frameIdx);
                    } else if (panelId === 'panel-lifespan' && window.renderLifespanChart) {
                        window.renderLifespanChart();
                    }
                }
            });
        }
    });
}

function initSpeedControl() {
    const speedSlider = document.getElementById('speed-slider');
    const speedDisplay = document.getElementById('speed-display');

    speedSlider.addEventListener('input', (e) => {
        playbackSpeed = parseFloat(e.target.value);
        speedDisplay.textContent = playbackSpeed.toFixed(1) + 'x';
    });
}

function initDownsampleControl() {
    const downsampleSlider = document.getElementById('downsample-slider');
    const downsampleDisplay = document.getElementById('downsample-display');
    const downsampleContainer = document.getElementById('downsample-container');

    if (window.animationData) {
        const maxCivs = Math.max(...window.animationData.frames.map(f => f.civilizations.length));
        
        if (maxCivs > 20) {
            downsampleContainer.style.display = 'flex';
            
            downsampleSlider.addEventListener('input', (e) => {
                downsamplePercent = parseInt(e.target.value);
                if (downsamplePercent === 0) {
                    downsampleDisplay.textContent = 'All';
                } else {
                    downsampleDisplay.textContent = 'Youngest ' + (100 - downsamplePercent) + '%';
                }
                if (window.updateCivilizationDisplay) {
                    window.updateCivilizationDisplay(downsamplePercent);
                }
            });
        }
    }
}

