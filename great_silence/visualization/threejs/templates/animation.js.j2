{# animation.js.j2 - Probe trail animation #}

const trailHistory = {};
const TRAIL_LENGTH = 3;

function createProbeTrails(probe_data) {
    const geometry = new THREE.BufferGeometry();
    const material = new THREE.LineBasicMaterial({
        color: 0x00ffff,
        transparent: true,
        opacity: 0.8
    });

    window.probeTrails = {};
    window.trailMeshes = {};

    for (let i = 0; i < probe_data.probe_ids.length; i++) {
        const probe_id = probe_data.probe_ids[i];
        trailHistory[probe_id] = [];
    }

    return { geometry, material };
}

function updateProbeTrails(probe_data, config) {
    for (let i = 0; i < probe_data.probe_ids.length; i++) {
        const probe_id = probe_data.probe_ids[i];
        const position = probe_data.positions[i];

        if (trailHistory[probe_id]) {
            trailHistory[probe_id].push({
                x: position[0],
                y: position[1],
                z: position[2]
            });

            if (trailHistory[probe_id].length > TRAIL_LENGTH) {
                trailHistory[probe_id].shift();
            }
        } else {
            trailHistory[probe_id] = [{
                x: position[0],
                y: position[1],
                z: position[2]
            }];
        }

        updateTrailGeometry(probe_id, trailHistory[probe_id], config);
    }
}

function updateTrailGeometry(probe_id, history, config) {
    if (history.length < 2) {
        return;
    }

    let mesh = window.trailMeshes[probe_id];
    if (!mesh) {
        const geometry = new THREE.BufferGeometry();
        const positions = new Float32Array(TRAIL_LENGTH * 3);

        geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

        const material = new THREE.LineBasicMaterial({
            color: 0x00ffff,
            transparent: true,
            opacity: 0.8
        });

        mesh = new THREE.Line(geometry, material);
        window.scene.add(mesh);
        window.trailMeshes[probe_id] = mesh;
    }

    const positions = mesh.geometry.attributes.position.array;
    const vertexCount = history.length;

    for (let i = 0; i < TRAIL_LENGTH; i++) {
        const idx = Math.min(i, vertexCount - 1);
        const point = history[idx];

        positions[i * 3] = point.x;
        positions[i * 3 + 1] = point.y;
        positions[i * 3 + 2] = point.z;
    }

    mesh.geometry.attributes.position.needsUpdate = true;
    mesh.geometry.setDrawRange(0, vertexCount);

    const progress = vertexCount / TRAIL_LENGTH;
    mesh.material.opacity = progress * 0.8;

    if (config.probe_glow_enabled) {
        mesh.material.blending = THREE.AdditiveBlending;
    }
}

function updateAllProbeTrails(frame_index, animation_data, config) {
    const frame = animation_data.frames[frame_index];
    const probes = frame.probes || [];

    const probe_data = {
        probe_ids: probes.map(p => p.id),
        positions: probes.map(p => p.position),
        civ_ids: probes.map(p => p.civ_id),
        progress: probes.map(p => p.progress || 0)
    };

    updateProbeTrails(probe_data, config);
}

function cleanupOldProbeTrails(active_probe_ids) {
    const active_ids = new Set(active_probe_ids);

    for (const probe_id in trailHistory) {
        if (!active_ids.has(parseInt(probe_id))) {
            delete trailHistory[probe_id];

            if (window.trailMeshes[probe_id]) {
                window.scene.remove(window.trailMeshes[probe_id]);
                delete window.trailMeshes[probe_id];
            }
        }
    }
}
