---
// StarField.astro - Animated parallax star background component
interface Props {
  density?: 'low' | 'medium' | 'high';
  animated?: boolean;
}

const { density = 'medium', animated = true } = Astro.props;

const starCounts = {
  low: 50,
  medium: 100,
  high: 200,
};

const count = starCounts[density];

// Generate random stars
const stars = Array.from({ length: count }, (_, i) => ({
  id: i,
  x: Math.random() * 100,
  y: Math.random() * 100,
  size: Math.random() * 2 + 0.5,
  opacity: Math.random() * 0.5 + 0.3,
  delay: Math.random() * 5,
  duration: Math.random() * 3 + 2,
}));
---

<div class="star-field" data-animated={animated}>
  {stars.map((star) => (
    <div
      class="star"
      style={`
        left: ${star.x}%;
        top: ${star.y}%;
        width: ${star.size}px;
        height: ${star.size}px;
        opacity: ${star.opacity};
        animation-delay: ${star.delay}s;
        animation-duration: ${star.duration}s;
      `}
    />
  ))}
</div>

<style>
  .star-field {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -2;
    overflow: hidden;
  }

  .star {
    position: absolute;
    background: white;
    border-radius: 50%;
  }

  .star-field[data-animated='true'] .star {
    animation: twinkle-star ease-in-out infinite alternate;
  }

  @keyframes twinkle-star {
    0% {
      opacity: 0.3;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.2);
    }
    100% {
      opacity: 0.5;
      transform: scale(1);
    }
  }

  /* Add some colored stars */
  .star:nth-child(7n) {
    background: #8B5CF6;
  }

  .star:nth-child(11n) {
    background: #00ffff;
  }

  .star:nth-child(13n) {
    background: #fbbf24;
  }
</style>
